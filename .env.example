# Which image provider renders the kitchen: "bedrock" (default), "openai", or "mock" (offline test image)
IMAGE_PROVIDER=bedrock

# --- Amazon Bedrock (Nova Canvas) ---
# Credentials: on AWS (EC2/ECS/App Runner/Lambda) use the server's IAM role and leave the keys out.
# Locally, either use an AWS profile (AWS_PROFILE=...) or set the two keys below.
AWS_REGION=us-east-2
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-canvas-v1:0
BEDROCK_QUALITY=standard          # standard | premium
BEDROCK_CONTROL_MODE=SEGMENTATION # SEGMENTATION keeps the layout, freer restyle; CANNY_EDGE follows edges more strictly
BEDROCK_CONTROL_STRENGTH=0.7      # 0-1: higher = closer to the original room
BEDROCK_IMAGE_LONG_SIDE=1280      # output size of the longer side, in pixels

# --- OpenAI (optional alternative) ---
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=1536x1024

# Server
PORT=3000
BRAND_NAME=AI Design Studio
BRAND_SITE=siyothsoftware.com

# Basic abuse protection: renders allowed per IP per hour
RATE_LIMIT_PER_HOUR=10