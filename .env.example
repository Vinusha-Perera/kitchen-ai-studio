# Which image provider renders the kitchen: "openai" (real AI) or "mock" (offline test image)
IMAGE_PROVIDER=openai

# OpenAI key with access to the Images API
OPENAI_API_KEY=sk-...

# Image model and quality. gpt-image-1 supports editing an uploaded photo.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium   # low | medium | high (cost and speed go up with quality)
OPENAI_IMAGE_SIZE=1536x1024   # landscape suits kitchen photos

# Server
PORT=3000
BRAND_NAME=AI Design Studio
BRAND_SITE=yourcompany.com

# Basic abuse protection: renders allowed per IP per hour
RATE_LIMIT_PER_HOUR=10
